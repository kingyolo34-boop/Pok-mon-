+    setflag FLAG_RESCUED_BIRCH
+    setobjectxy LOCALID_ROUTE101_BIRCH, 9, 13
+    clearflag FLAG_FALLEN_ASHE_ROOK_HIDDEN
+    addobject LOCALID_ROUTE101_ROOK
+    setobjectxy LOCALID_ROUTE101_ROOK, 9, 11
+    fadescreen FADE_FROM_BLACK
+    applymovement LOCALID_ROUTE101_ROOK, Common_Movement_WalkInPlaceFasterDown
+    waitmovement 0
+    msgbox FallenAshe_Text_RookArrives, MSGBOX_DEFAULT
     msgbox FallenAshe_Text_MomFinalWords, MSGBOX_DEFAULT
+    playse SE_THUNDER
     fadescreen FADE_TO_BLACK
     removeobject LOCALID_ROUTE101_BIRCH
     setflag FLAG_HIDE_ROUTE_101_BIRCH_ZIGZAGOON_BATTLE
@@ -236,12 +253,14 @@
     setflag FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE
     setflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_MOM
